{
  "name": "autopulse-labs-2-6",
  "version": "1.0.0",
  "private": true,
  "description": "Навчальний повностековий застосунок інтернет-магазину автотоварів AutoPulse (лабораторні 2–6)",
  "engines": { "node": ">=22.12.0" },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "db:setup": "node server/db/setup.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/src/index.js",
    "test": "node --test server/tests/validation.test.js"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "vite": "^7.1.0"
  }
}
