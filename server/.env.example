PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://autopulse_user:YOUR_PASSWORD@localhost:5432/autopulse
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
METRICS_TOKEN=REPLACE_WITH_RANDOM_TOKEN_16_PLUS
# Публічна адреса після деплою, напр. https://autopulse-fullstack.onrender.com
APP_ORIGIN=

# Лабораторна №6: gemini (безкоштовний ключ Google AI Studio) або openai
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
